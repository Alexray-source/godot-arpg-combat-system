[layer_names]

3d_physics/layer_1="Non-interactable"
3d_physics/layer_2="Character"
3d_physics/layer_3="Player"
3d_physics/layer_4="Enemy"
3d_physics/layer_5="Interactable"
3d_physics/layer_10="InvisibleCollider"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=19.6

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/vsync/vsync_mode=0
environment/delta_smoothing=false
environment/stretch/mode="canvas_items"
environment/stretch/aspect="expand"
